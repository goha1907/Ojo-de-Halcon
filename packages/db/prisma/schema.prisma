generator client {
  provider = "prisma-client"
  output   = "../src/generated"
}

datasource db {
  provider = "postgresql"
}

enum EmailTokenType {
  VERIFY_EMAIL
  RESET_PASSWORD
}

/// Who an account is: a customer, or staff of the admin area.
enum UserRole {
  USER
  SUPPORT
  ADMIN
}

model User {
  id                    String    @id @default(cuid())
  email                 String    @unique
  /// One key per real mailbox (see canonicalEmail); blocks address variations.
  emailCanonical        String    @unique
  role                  UserRole  @default(USER)
  /// May use services that are not open to everyone yet (staff always may).
  earlyAccess           Boolean   @default(false)
  passwordHash          String
  emailVerifiedAt       DateTime?
  firstName             String?
  lastName              String?
  birthDate             DateTime? @db.Date
  /// PJN jurisdiction (select value) used to find the user's case by name.
  pjnJurisdiction       String?
  telegramId            BigInt?   @unique
  telegramUsername      String?
  telegramLinkedAt      DateTime?
  locale                String    @default("ru")
  termsAcceptedAt       DateTime
  onboardingCompletedAt DateTime?
  /// Paid access end (payments are not connected yet; set manually).
  subscriptionUntil     DateTime?
  /// Cases the subscription pays for in the running period (free slots = paidCases - active cases).
  paidCases             Int       @default(0)
  /// When the subscription was cancelled (it will not renew); null = it renews. Cases are untouched.
  subscriptionCancelledAt DateTime?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  sessions         Session[]
  profileChanges   ProfileChange[]
  emailTokens      EmailToken[]
  telegramLinkCode TelegramLinkCode?
  trackers         Tracker[]
  payments         Payment[]
  feedback         FeedbackMessage[]
  paymentIntents   PaymentIntent[]
  freeGrants       FreeGrant[]
}

model Session {
  id        String   @id @default(cuid())
  tokenHash String   @unique
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([userId])
}

/// One-time e-mail links (verification, password reset). Only hashes are stored.
model EmailToken {
  id        String         @id @default(cuid())
  userId    String
  user      User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  type      EmailTokenType
  tokenHash String         @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime       @default(now())

  @@index([userId, type])
}

/// Code a signed-in user sends to the bot to link their Telegram account.
/// At most one active code per user.
model TelegramLinkCode {
  id        String   @id @default(cuid())
  userId    String   @unique
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  codeHash  String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())
}

/// Audit trail of profile edits (name, surname, birth date).
model ProfileChange {
  id        String   @id @default(cuid())
  userId    String
  field     String
  oldValue  String
  newValue  String
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

enum TrackerKind {
  RENAPER
  CORREO
  PJN
  /// Migraciones: DNI residence resolution (precaria), by file number + birth date.
  DNM_DNI
  /// Migraciones: citizenship procedure, by order number + birth date.
  DNM_CITIZENSHIP
  /// OCASA (carrier): updated by hand only, the site is behind a human check.
  OCASA
}

enum TrackerStatus {
  /// PJN case found by name, waiting for the user to confirm it is theirs.
  PENDING_CONFIRMATION
  ACTIVE
  FINISHED
  /// Over the slot limit after a reduction; kept for a while, not checked.
  PAUSED
}

/// One tracked procedure of one user. RENAPER and CORREO are independent sources.
model Tracker {
  id              String        @id @default(cuid())
  userId          String
  user            User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  /// Since when this slot holds this case (creation or last replacement); starts the cooldown.
  slotSince       DateTime      @default(now())
  /// false: this tracker is paused when a scheduled reduction takes effect.
  keepNext        Boolean       @default(true)
  /// When it was paused; paused trackers are removed after a retention period.
  pausedAt        DateTime?
  /// When an open case reached its final status (its slot became free). Null for cases added already closed.
  finishedAt      DateTime?
  /// The "case added" notification was produced (it waits while Telegram is switched off for the case).
  initialNotified Boolean       @default(false)
  kind            TrackerKind
  /// RENAPER/CORREO: trámite number. PJN: "<jurisdiction>:<number>:<year>".
  reference       String
  label           String?
  status          TrackerStatus @default(ACTIVE)
  lastCheckedAt   DateTime?
  nextCheckAt     DateTime      @default(now())
  lastError       String?
  /// Notifications of this case go to Telegram.
  notifyTelegram  Boolean       @default(true)
  /// Notifications of this case go to WhatsApp (the bot does not exist yet).
  notifyWhatsapp  Boolean       @default(false)
  /// Holder's birth date for Migraciones kinds (entered when adding; falls back to the profile).
  holderBirthDate DateTime?     @db.Date
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  snapshot TrackerSnapshot?
  events   TrackerEvent[]

  @@unique([userId, kind, reference])
  @@index([status, nextCheckAt])
}

/// Latest parsed state of a tracker: header plus the list of stages.
model TrackerSnapshot {
  trackerId   String   @id
  tracker     Tracker  @relation(fields: [trackerId], references: [id], onDelete: Cascade)
  header      Json
  steps       Json
  contentHash String
  updatedAt   DateTime @updatedAt
}

/// One attempt to pay: the amount is fixed when it is created and the purchase is applied once,
/// when the provider reports success (by polling or by webhook).
model PaymentIntent {
  id            String    @id @default(cuid())
  userId        String
  user          User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  expiresAt     DateTime
  completedAt   DateTime?
  /// mercadopago_qr | card
  method        String
  provider      String
  /// The provider's own id of the payment.
  providerRef   String?
  /// PENDING | PROCESSING | SUCCEEDED | FAILED | CANCELLED | EXPIRED
  status        String    @default("PENDING")
  failureReason String?
  /// Whole units of `currency`.
  amount        Int
  currency      String
  /// Cases the subscription holds after this payment.
  targetCases   Int

  @@index([userId, createdAt])
  @@index([status, expiresAt])
}

/// Anonymous tally of the statuses and stages seen at the sources (no user, case or number):
/// the product learns which statuses exist, which end a case and which are borderline.
model StatusObservation {
  id          String   @id @default(cuid())
  /// TrackerKind value the status came from.
  kind        String
  /// "status" (state of the case) or "step" (title of a stage).
  field       String
  value       String
  /// Times it appeared as a change in some case.
  count       Int      @default(1)
  firstSeenAt DateTime @default(now())
  lastSeenAt  DateTime @default(now())

  @@unique([kind, field, value])
  @@index([kind, field])
}

/// A message written through the contact form of the landing page; read in the admin area.
model FeedbackMessage {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())
  /// tracking | technical | subscription | suggestion | partnership | other
  topic     String
  name      String?
  email     String
  message   String
  locale    String   @default("ru")
  /// Set when the sender was signed in.
  userId    String?
  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  /// NEW | READ | ANSWERED | SPAM (handled in the admin area).
  status    String   @default("NEW")
  /// The answer sent from the admin area (simulated until the support mail is connected).
  reply     String?
  repliedAt DateTime?
  repliedBy String?

  @@index([status, createdAt])
}

/// A detected change; `notifiedAt` is null until the Telegram message is sent.
model TrackerEvent {
  /// Set by the worker that is about to send the message (prevents double delivery).
  claimedAt  DateTime?
  id         String    @id @default(cuid())
  trackerId  String
  tracker    Tracker   @relation(fields: [trackerId], references: [id], onDelete: Cascade)
  /// Structured change description; formatted per user locale when sent.
  payload    Json
  createdAt  DateTime  @default(now())
  notifiedAt DateTime?

  @@index([trackerId])
  @@index([notifiedAt])
}

/// Telegram messages to send after the account (or the link) is gone, so they
/// cannot reference the user. Delivered and removed by the worker.
model TelegramOutbox {
  /// Set by the worker that is about to send the message (prevents double delivery).
  claimedAt  DateTime?
  id         String    @id @default(cuid())
  telegramId BigInt
  /// Message kind: "account_deleted" | "unlinked" | "person_added" | "person_removed"
  kind       String
  locale     String
  /// Message parameters (e.g. the relative's name).
  payload    Json?
  attempts   Int       @default(0)
  createdAt  DateTime  @default(now())
  sentAt     DateTime?

  @@index([sentAt, createdAt])
}

/// Free places: the trial, bonuses, gifts, partner access. They cost nothing and are only counted; paid places
/// live in `User.paidCases`. A grant without `expiresAt` goes on without an end until it is revoked.
model FreeGrant {
  id              String    @id @default(cuid())
  userId          String
  user            User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  /// "TRIAL" | "BONUS" | "GIFT" | "PROMO" | "ADMIN"
  kind            String
  /// How many cases the grant covers.
  cases           Int
  note            String?
  /// Who gave it ("system" for the trial, an admin label otherwise).
  grantedBy       String?
  startsAt        DateTime  @default(now())
  /// Null: no end date, it keeps going (renewed every month like a paid place).
  expiresAt       DateTime?
  revokedAt       DateTime?
  /// The ending of this grant was processed (the owner was told when cases were left without a place).
  expiryHandledAt DateTime?
  createdAt       DateTime  @default(now())

  @@index([userId])
  @@index([expiresAt, expiryHandledAt])
}

/// Everything staff do in the admin area. Kept after accounts are deleted, so it stores copies of the e-mails.
model AuditLog {
  id           String   @id @default(cuid())
  createdAt    DateTime @default(now())
  actorId      String?
  actorEmail   String
  /// e.g. "grant.give", "grant.revoke", "grant.expiry", "feedback.status"
  action       String
  targetUserId String?
  targetEmail  String?
  details      Json?
  /// Idempotency key of a form submit: sending the same form twice acts once.
  requestId    String?  @unique

  @@index([targetUserId, createdAt])
  @@index([createdAt])
}

/// Remembers used trials after an account is deleted. Only keyed hashes are
/// stored, never the e-mail or the case number itself.
model TrialLedger {
  id             String    @id @default(cuid())
  /// HMAC of "email:<canonical>".
  keyHash        String    @unique
  /// Entry type; only "email" for now.
  kind           String
  trialStartedAt DateTime?
  createdAt      DateTime  @default(now())
}

/// Payment history. Kept (user becomes null) when an account is deleted, so
/// refunds and accounting stay possible; holds no personal data itself.
model Payment {
  id         String   @id @default(cuid())
  userId     String?
  user       User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  /// Whole units of `currency`.
  amount     Int
  currency   String
  /// "subscription" | "cases" | "renewal"
  kind       String
  /// Cases bought with this payment.
  casesDelta Int      @default(0)
  /// Payment provider; "stub" until real billing is connected.
  provider   String
  /// How it was paid: mercadopago_qr | card (null for renewals made without a checkout).
  method     String?
  /// The checkout that produced it.
  intentId   String?  @unique
  /// Link to the receipt or payment document of the provider (filled in when real billing is connected).
  receiptUrl String?
  createdAt  DateTime @default(now())

  @@index([userId, createdAt])
}

/// A news entry written in the admin area, one row per language; rows with the same `slug` are one entry.
/// An entry with the same slug and language as a file in apps/web/content/news replaces that file.
/// A picture uploaded for a news entry in the admin area. Kept in the database, so it survives deploys and needs no
/// file storage; `NewsPost.image` points to it as `/api/news/image/<id>`.
model NewsImage {
  id        String   @id @default(cuid())
  mime      String
  data      Bytes
  createdAt DateTime @default(now())
}

model NewsPost {
  id        String   @id @default(cuid())
  /// `YYYY-MM-DD-name`, also the URL segment.
  slug      String
  locale    String
  /// `YYYY-MM-DD` and `HH:MM` of the publication (orders the list, newest first).
  date      String
  time      String   @default("00:00")
  title     String
  summary   String   @default("")
  /// Markdown.
  body      String
  /// The main news: shown big on the home page. At most one entry has it; every language row of it carries the flag.
  featured  Boolean  @default(false)
  /// Cover picture under `/news/` (one of the built-in covers); null = the default cover.
  image     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([slug, locale])
  @@index([date, time])
}
