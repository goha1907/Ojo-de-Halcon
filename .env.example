# Copy to `.env` and fill in. `.env` is git-ignored; never commit real values.

# --- App ---
APP_URL=http://localhost:3000

# --- Database (docker compose `db` service) ---
POSTGRES_USER=ojo
POSTGRES_PASSWORD=change-me
POSTGRES_DB=ojo_de_halcon
POSTGRES_PORT=5435
DATABASE_URL=postgresql://ojo:change-me@localhost:5435/ojo_de_halcon
# Separate database for automated tests (created by `pnpm db:create-test`)
TEST_DATABASE_URL=postgresql://ojo:change-me@localhost:5435/ojo_test

# --- Sessions ---
# Random string, 32+ bytes. Generate: openssl rand -hex 32
SESSION_SECRET=
SESSION_TTL_DAYS=30

# --- Telegram ---
# Token from @BotFather
TELEGRAM_BOT_TOKEN=
# Bot username without @ (used to build t.me/<username>?start=<code> links)
TELEGRAM_BOT_USERNAME=
# Lifetime of the one-time code used to link a Telegram account
TELEGRAM_LINK_CODE_TTL_MINUTES=10

# --- E-mail ---
# "true": unverified e-mails cannot use the product (needs a mail provider).
# "false": accounts are created verified; mails are only logged (development).
EMAIL_VERIFICATION_REQUIRED=false

# --- Scraper (Python sidecar: RENAPER / Correo / PJN) ---
# Create once: cd services/scraper && python3 -m venv .venv && source .venv/bin/activate \
#   && pip install -r requirements.txt && playwright install chromium
SCRAPER_PYTHON=services/scraper/.venv/bin/python
SCRAPER_DIR=services/scraper
SCRAPER_TIMEOUT_SECONDS=150
SCRAPER_CONCURRENCY=1

# --- Payments ---
# "true": settings show test buttons that grant a subscription without payment.
# Unset = on in development, off in production. NEVER set "true" on a real deployment.
# PAYMENTS_STUB=true

# --- Features ---
# "true": relatives (extra people with paid slots). Dormant by default: one user,
# one tracker per section. The code and data stay in place.
# FEATURE_RELATIVES=false
