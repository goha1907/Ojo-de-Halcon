{
  "name": "ojo-de-halcon",
  "private": true,
  "packageManager": "pnpm@12.6.0",
  "engines": {
    "node": ">=20.19"
  },
  "scripts": {
    "dev": "bash scripts/dev.sh",
    "dev:web": "pnpm --filter @ojo/web dev",
    "dev:worker": "pnpm --filter @ojo/worker dev",
    "build": "pnpm -r build",
    "typecheck": "pnpm -r typecheck",
    "lint": "pnpm -r lint",
    "test": "pnpm -r test",
    "db:up": "docker compose up -d db",
    "db:create-test": "bash scripts/create-test-db.sh",
    "db:generate": "pnpm --filter @ojo/db generate",
    "db:migrate": "pnpm --filter @ojo/db migrate",
    "db:studio": "pnpm --filter @ojo/db studio",
    "db:down": "docker compose stop db",
    "admin:create": "pnpm --filter @ojo/worker admin:create"
  },
  "devDependencies": {
    "typescript": "5.9.3",
    "eslint": "^9.9.1",
    "typescript-eslint": "^8.0.0"
  }
}
